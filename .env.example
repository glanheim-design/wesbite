NEXT_PUBLIC_SITE_URL=https://glanheim.com
# Genuine Dropbox File Request only. Omit for email fallback.
DROPBOX_FILE_REQUEST_URL=
# Server only: verify a domain with Resend before using its sender.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
BUSINESS_NOTIFICATION_EMAIL=info@glanheim.com
# Enquiries fail closed until this is true and a privacy-reviewed Netlify store is available.
ENQUIRIES_ENABLED=false
# Rate limit identities are hashed, never stored as raw IPs. Generate a strong random secret.
RATE_LIMIT_SALT=
# Netlify injects Blobs authentication in production. Local dev uses unavailable integration state.
# Optional additional acknowledgement; off until business owner approves sending.
SEND_CUSTOMER_ACKNOWLEDGEMENT=false

# Netlify Forms is the default on Netlify when the optional Resend integration is absent.
# Enable form detection in Netlify and add an email notification for glanheim-project-enquiry.
# Set to false only to deliberately use the email/download fallback.
NETLIFY_FORMS_ENABLED=true
# Native submissions are stored by Netlify Forms. Its email notification recipient
# must be configured in the Netlify dashboard; BUSINESS_NOTIFICATION_EMAIL only
# controls the optional Resend API transport.
